# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# E-posta bildirimi (Brevo) — abonelere "yeni not" maili için
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Notvia

# E-postadaki linkler için site adresi (opsiyonel; yoksa istek origin'i kullanılır)
NEXT_PUBLIC_SITE_URL=

# AI (Google Gemini) — not özeti + embedding (ZORUNLU) ve birincil sohbet modeli
GEMINI_API_KEY=

# AI çalışma arkadaşı — ücretsiz sohbet fallback sağlayıcıları (opsiyonel).
# Gemini kota verirse sırayla bunlara düşülür. Sadece sohbet için; embedding hep Gemini.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=qwen-3.8-27b
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen3.8-27b:free
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# Payments (iyzico subscriptions) — kapalı kalır; açmak için PAYMENTS_ENABLED=true + anahtarlar
PAYMENTS_ENABLED=false
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_PLAN_PREMIUM_MONTHLY=
IYZICO_PLAN_PREMIUM_YEARLY=
IYZICO_PLAN_PRO_MONTHLY=
IYZICO_PLAN_PRO_YEARLY=

# Reklam (Google AdSense) — canlıda; boşsa reklam alanı yer tutucu olur
NEXT_PUBLIC_ADSENSE_CLIENT=

# Haftalık özet cron güvenliği (Vercel Cron bunu otomatik Bearer olarak yollar)
CRON_SECRET=
